// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  createdAt DateTime @default(now())
}

model ApiLog {
  id               String   @id @default(uuid())
  provider         String
  model            String
  taskType         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  durationMs       Int
  success          Boolean
  errorMsg         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([provider, model])
}

enum MaterialSourceType {
  text
  image
  pdf
}

model Material {
  id          String             @id @default(uuid())
  title       String
  sourceType  MaterialSourceType
  rawContent  String
  metadata    Json?
  createdAt   DateTime           @default(now())

  cards       Card[]
}

enum CardType {
  cloze
  qa
  judge
}

enum MasteryLevel {
  new
  learning
  familiar
  mastered
}

model Card {
  id            String       @id @default(uuid())
  materialId    String
  material      Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  question      String
  answer        String
  hint          String?
  cardType      CardType
  mastery       MasteryLevel @default(new)
  intervalDays  Int          @default(0)
  nextReviewAt  DateTime     @default(now())
  reviewCount   Int          @default(0)
  lapseCount    Int          @default(0)
  goodStreak    Int          @default(0)
  metadata      Json?
  createdAt     DateTime     @default(now())

  reviewLogs    ReviewLog[]

  @@index([materialId])
  @@index([nextReviewAt])
}

enum ReviewResult {
  forgot
  hard
  good
  easy
}

model ReviewLog {
  id           String       @id @default(uuid())
  cardId       String
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  reviewedAt   DateTime     @default(now())
  result       ReviewResult
  userAnswer   String?
  aiFeedback   String?

  @@index([cardId])
  @@index([reviewedAt])
}

enum GoalCategory {
  exam
  project
  habit
}

enum GoalStatus {
  active
  done
  archived
}

enum TaskStatus {
  pending
  done
  skipped
}

model Goal {
  id           String       @id @default(uuid())
  title        String
  category     GoalCategory
  deadline     DateTime
  dailyMinutes Int
  status       GoalStatus   @default(active)
  userContext  String
  metadata     Json?
  createdAt    DateTime     @default(now())

  phases        Phase[]
  tasks         Task[]
  weeklyReports WeeklyReport[]

  @@index([status])
}

model Phase {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  focus     String
  order     Int
  metadata  Json?

  tasks Task[]

  @@index([goalId])
}

model Task {
  id         String     @id @default(uuid())
  goalId     String
  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  phaseId    String?
  phase      Phase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  title      String
  detail     String
  estMinutes Int
  dueDate    DateTime
  status     TaskStatus @default(pending)
  resultNote String?
  doneAt     DateTime?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([goalId, dueDate])
  @@index([status])
}

model WeeklyReport {
  id             String   @id @default(uuid())
  goalId         String
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  weekStart      DateTime
  completionRate Float
  aiSummary      String
  adjustments    String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([goalId, weekStart])
}
