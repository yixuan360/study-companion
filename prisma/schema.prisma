// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  studentNo String?
  pushKey   String?
  // MVP 轻量账号体系：sessionToken 存 httpOnly cookie，无密码注册，未来可换 NextAuth
  sessionToken String? @unique
  createdAt DateTime @default(now())
}

enum ClassTaskSourceType {
  text
  screenshot
}

enum ClassTaskType {
  homework
  exam
  activity
  notice
}

model Classroom {
  id         String    @id @default(uuid())
  name       String
  inviteCode String    @unique
  creatorId  String
  metadata   Json?
  createdAt  DateTime  @default(now())
  // 邀请码有效期，null 表示永久有效（迁移前存量数据）；新建默认 7 天（见 modules/classroom/invite.ts）
  inviteExpireAt DateTime?

  members ClassroomMember[]
  tasks   ClassTask[]

  @@index([creatorId])
}

model ClassroomMember {
  id          String    @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // userId 为逻辑外键（不设 FK 约束），用户体系为 MVP 轻量方案
  userId      String
  joinedAt    DateTime  @default(now())
  metadata    Json?

  @@unique([classroomId, userId])
  @@index([userId])
}

model ClassTask {
  id          String             @id @default(uuid())
  classroomId String
  classroom   Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  title       String
  detail      String
  platform    String
  course      String?
  deadline    DateTime
  sourceType  ClassTaskSourceType @default(text)
  type        ClassTaskType
  createdBy   String
  updatedBy   String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  completions TaskCompletion[]

  @@index([classroomId, deadline])
}

model TaskCompletion {
  id       String    @id @default(uuid())
  taskId   String
  task     ClassTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  done     Boolean   @default(false)
  doneAt   DateTime?
  metadata Json?

  @@unique([taskId, userId])
  @@index([userId])
}

enum GraphSourceType {
  text
  url
  screenshot
  pdf
}

// 知识图谱：内容源（用户"喂"进来的材料）
model Source {
  id         String          @id @default(uuid())
  title      String
  sourceType GraphSourceType @default(text)
  rawContent String
  url        String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  nodeSources NodeSource[]

  @@index([createdAt])
}

// 知识点节点（SQLite 无标量数组，aliases 存 Json 字符串数组；迁 PG 可换 String[]）
model GraphNode {
  id           String   @id @default(uuid())
  name         String   @unique
  aliases      Json
  domain       String
  summary      String
  mentionCount Int      @default(1)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  edgesFrom   GraphEdge[]  @relation("fromNode")
  edgesTo     GraphEdge[]  @relation("toNode")
  nodeSources NodeSource[]

  @@index([domain])
}

// 关系边（relation 为简短动词）
model GraphEdge {
  id        String    @id @default(uuid())
  fromNodeId String
  fromNode  GraphNode @relation("fromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId  String
  toNode    GraphNode @relation("toNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  relation  String
  weight    Int       @default(1)
  metadata  Json?
  createdAt DateTime  @default(now())

  @@unique([fromNodeId, toNodeId, relation])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// 溯源：节点出自哪篇材料的哪个片段
model NodeSource {
  id       String    @id @default(uuid())
  nodeId   String
  node     GraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  sourceId String
  source   Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  excerpt  String
  metadata Json?

  @@unique([nodeId, sourceId])
  @@index([sourceId])
}

// 合并待审队列（align 对齐 / conflict 冲突），处理结果写 status
enum MergeReviewType {
  align
  conflict
}

enum MergeReviewStatus {
  pending
  approved
  rejected
}

model MergeReview {
  id        String            @id @default(uuid())
  type      MergeReviewType
  payload   Json
  status    MergeReviewStatus @default(pending)
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([status, type])
}

model ApiLog {
  id               String   @id @default(uuid())
  provider         String
  model            String
  taskType         String
  module           String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  durationMs       Int
  success          Boolean
  errorMsg         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([provider, model])
}

enum MaterialSourceType {
  text
  image
  pdf
}

model Material {
  id          String             @id @default(uuid())
  title       String
  sourceType  MaterialSourceType
  rawContent  String
  metadata    Json?
  createdAt   DateTime           @default(now())

  cards       Card[]
}

enum CardType {
  cloze
  qa
  judge
}

enum MasteryLevel {
  new
  learning
  familiar
  mastered
}

model Card {
  id            String       @id @default(uuid())
  materialId    String
  material      Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  question      String
  answer        String
  hint          String?
  cardType      CardType
  mastery       MasteryLevel @default(new)
  intervalDays  Int          @default(0)
  nextReviewAt  DateTime     @default(now())
  reviewCount   Int          @default(0)
  lapseCount    Int          @default(0)
  goodStreak    Int          @default(0)
  metadata      Json?
  createdAt     DateTime     @default(now())

  reviewLogs    ReviewLog[]

  @@index([materialId])
  @@index([nextReviewAt])
}

enum ReviewResult {
  forgot
  hard
  good
  easy
}

model ReviewLog {
  id           String       @id @default(uuid())
  cardId       String
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  reviewedAt   DateTime     @default(now())
  result       ReviewResult
  userAnswer   String?
  aiFeedback   String?

  @@index([cardId])
  @@index([reviewedAt])
}

enum GoalCategory {
  exam
  project
  habit
}

enum GoalStatus {
  active
  done
  archived
}

enum TaskStatus {
  pending
  done
  skipped
}

model Goal {
  id           String       @id @default(uuid())
  title        String
  category     GoalCategory
  deadline     DateTime
  dailyMinutes Int
  status       GoalStatus   @default(active)
  userContext  String
  metadata     Json?
  createdAt    DateTime     @default(now())

  phases        Phase[]
  tasks         Task[]
  weeklyReports WeeklyReport[]

  @@index([status])
}

model Phase {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  focus     String
  order     Int
  metadata  Json?

  tasks Task[]

  @@index([goalId])
}

model Task {
  id         String     @id @default(uuid())
  goalId     String
  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  phaseId    String?
  phase      Phase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  title      String
  detail     String
  estMinutes Int
  dueDate    DateTime
  status     TaskStatus @default(pending)
  resultNote String?
  doneAt     DateTime?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([goalId, dueDate])
  @@index([status])
}

model WeeklyReport {
  id             String   @id @default(uuid())
  goalId         String
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  weekStart      DateTime
  completionRate Float
  aiSummary      String
  adjustments    String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([goalId, weekStart])
}
