# Server 酱 Turbo SendKey，用于微信推送
# 获取地址：https://sct.ftqq.com/
SERVER_CHAN_SEND_KEY=

# SQLite 数据库地址（相对 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# 定时提醒接口 /api/cron/daily-reminder 的访问密钥（可选）
# 外部 cron 服务调用时需携带：?secret=xxx 或 Authorization: Bearer xxx
CRON_SECRET=

# AI 网关：DeepSeek（默认，simple 任务）
DEEPSEEK_API_KEY=
# 模型名（可选），默认 deepseek-chat；V4.1 Flash 填 deepseek-flash
DEEPSEEK_MODEL=

# AI 网关：Kimi（可选，complex 任务；不配置则回退 DeepSeek）
KIMI_API_KEY=
KIMI_MODEL=
